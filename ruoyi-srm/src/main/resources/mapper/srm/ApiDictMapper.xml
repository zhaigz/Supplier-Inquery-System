  <insert id="insertApiDict" parameterType="com.ruoyi.srm.domain.ApiDict" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_api_dict (api_id, api_name, api_category, doc_url, unit_price, price_unit, is_page_query, page_size_max, billing_mode, async_flag, show_flag, status, cache_ttl_sec, depth_max, remark) VALUES (#{apiId}, #{apiName}, #{apiCategory}, #{docUrl}, #{unitPrice}, #{priceUnit}, #{isPageQuery}, #{pageSizeMax}, #{billingMode}, #{asyncFlag}, #{showFlag}, #{status}, #{cacheTtlSec}, #{depthMax}, #{remark})</insert>
  <update id="updateApiDict" parameterType="com.ruoyi.srm.domain.ApiDict">UPDATE srm_api_dict<set>
