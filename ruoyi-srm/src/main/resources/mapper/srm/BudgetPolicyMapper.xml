<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.BudgetPolicyMapper">
  <resultMap id="BudgetPolicyResult" type="com.ruoyi.srm.domain.BudgetPolicy">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="policyName" column="policy_name" jdbcType="VARCHAR" />
    <result property="dailyLimit" column="daily_limit" jdbcType="INTEGER" />
    <result property="monthlyLimit" column="monthly_limit" jdbcType="INTEGER" />
    <result property="warnRatios" column="warn_ratios" jdbcType="VARCHAR" />
    <result property="maxConcurrency" column="max_concurrency" jdbcType="INTEGER" />
    <result property="autoFullScan" column="auto_full_scan" jdbcType="VARCHAR" />
    <result property="cacheTtlSec" column="cache_ttl_sec" jdbcType="INTEGER" />
    <result property="monitorFrequency" column="monitor_frequency" jdbcType="VARCHAR" />
    <result property="monitorMaxEnt" column="monitor_max_ent" jdbcType="INTEGER" />
    <result property="status" column="status" jdbcType="VARCHAR" />
    <result property="createBy" column="create_by" jdbcType="VARCHAR" />
    <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
    <result property="updateBy" column="update_by" jdbcType="VARCHAR" />
    <result property="updateTime" column="update_time" jdbcType="TIMESTAMP" />
    <result property="remark" column="remark" jdbcType="VARCHAR" />
  </resultMap>
  <sql id="selectBudgetPolicyVo">SELECT id, policy_name, daily_limit, monthly_limit, warn_ratios, max_concurrency, auto_full_scan, cache_ttl_sec, monitor_frequency, monitor_max_ent, status, create_by, create_time, update_by, update_time, remark FROM srm_budget_policy</sql>
  <select id="selectBudgetPolicyById" parameterType="Long" resultMap="BudgetPolicyResult"><include refid="selectBudgetPolicyVo"/> WHERE id = #{id}</select>
  <select id="selectBudgetPolicyList" parameterType="com.ruoyi.srm.domain.BudgetPolicy" resultMap="BudgetPolicyResult"><include refid="selectBudgetPolicyVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="policyName != null and policyName != ''">AND policy_name = #{policyName}</if>
    <if test="dailyLimit != null">AND daily_limit = #{dailyLimit}</if>
    <if test="monthlyLimit != null">AND monthly_limit = #{monthlyLimit}</if>
    <if test="warnRatios != null and warnRatios != ''">AND warn_ratios = #{warnRatios}</if>
    <if test="maxConcurrency != null">AND max_concurrency = #{maxConcurrency}</if>
    <if test="autoFullScan != null and autoFullScan != ''">AND auto_full_scan = #{autoFullScan}</if>
    <if test="cacheTtlSec != null">AND cache_ttl_sec = #{cacheTtlSec}</if>
    <if test="monitorFrequency != null and monitorFrequency != ''">AND monitor_frequency = #{monitorFrequency}</if>
    <if test="monitorMaxEnt != null">AND monitor_max_ent = #{monitorMaxEnt}</if>
    <if test="status != null and status != ''">AND status = #{status}</if>
  </where></select>
  <insert id="insertBudgetPolicy" parameterType="com.ruoyi.srm.domain.BudgetPolicy" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_budget_policy (policy_name, daily_limit, monthly_limit, warn_ratios, max_concurrency, auto_full_scan, cache_ttl_sec, monitor_frequency, monitor_max_ent, status, create_by, create_time, update_by, update_time, remark) VALUES (#{policyName}, #{dailyLimit}, #{monthlyLimit}, #{warnRatios}, #{maxConcurrency}, #{autoFullScan}, #{cacheTtlSec}, #{monitorFrequency}, #{monitorMaxEnt}, #{status}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{remark})</insert>
  <update id="updateBudgetPolicy" parameterType="com.ruoyi.srm.domain.BudgetPolicy">UPDATE srm_budget_policy<set>
    <if test="policyName != null">policy_name = #{policyName},</if>
    <if test="dailyLimit != null">daily_limit = #{dailyLimit},</if>
    <if test="monthlyLimit != null">monthly_limit = #{monthlyLimit},</if>
    <if test="warnRatios != null">warn_ratios = #{warnRatios},</if>
    <if test="maxConcurrency != null">max_concurrency = #{maxConcurrency},</if>
    <if test="autoFullScan != null">auto_full_scan = #{autoFullScan},</if>
    <if test="cacheTtlSec != null">cache_ttl_sec = #{cacheTtlSec},</if>
    <if test="monitorFrequency != null">monitor_frequency = #{monitorFrequency},</if>
    <if test="monitorMaxEnt != null">monitor_max_ent = #{monitorMaxEnt},</if>
    <if test="status != null">status = #{status},</if>
    <if test="createBy != null">create_by = #{createBy},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteBudgetPolicyById" parameterType="Long">DELETE FROM srm_budget_policy WHERE id = #{id}</delete>
  <delete id="deleteBudgetPolicyByIds" parameterType="array">DELETE FROM srm_budget_policy WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
