<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.DataSnapshotMapper">
  <resultMap id="DataSnapshotResult" type="com.ruoyi.srm.domain.DataSnapshot">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="supplierId" column="supplier_id" jdbcType="BIGINT" />
    <result property="creditCode" column="credit_code" jdbcType="VARCHAR" />
    <result property="snapshotType" column="snapshot_type" jdbcType="VARCHAR" />
    <result property="snapshotKey" column="snapshot_key" jdbcType="VARCHAR" />
    <result property="snapshotHash" column="snapshot_hash" jdbcType="VARCHAR" />
    <result property="payloadJson" column="payload_json" jdbcType="VARCHAR" />
    <result property="apiIds" column="api_ids" jdbcType="VARCHAR" />
    <result property="rawId" column="raw_id" jdbcType="BIGINT" />
    <result property="capturedAt" column="captured_at" jdbcType="TIMESTAMP" />
    <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
  </resultMap>
  <sql id="selectDataSnapshotVo">SELECT id, supplier_id, credit_code, snapshot_type, snapshot_key, snapshot_hash, payload_json, api_ids, raw_id, captured_at, create_time FROM srm_data_snapshot</sql>
  <select id="selectDataSnapshotById" parameterType="Long" resultMap="DataSnapshotResult"><include refid="selectDataSnapshotVo"/> WHERE id = #{id}</select>
  <select id="selectDataSnapshotList" parameterType="com.ruoyi.srm.domain.DataSnapshot" resultMap="DataSnapshotResult"><include refid="selectDataSnapshotVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="supplierId != null">AND supplier_id = #{supplierId}</if>
    <if test="creditCode != null and creditCode != ''">AND credit_code = #{creditCode}</if>
    <if test="snapshotType != null and snapshotType != ''">AND snapshot_type = #{snapshotType}</if>
    <if test="snapshotKey != null and snapshotKey != ''">AND snapshot_key = #{snapshotKey}</if>
    <if test="snapshotHash != null and snapshotHash != ''">AND snapshot_hash = #{snapshotHash}</if>
    <if test="payloadJson != null and payloadJson != ''">AND payload_json = #{payloadJson}</if>
    <if test="apiIds != null and apiIds != ''">AND api_ids = #{apiIds}</if>
    <if test="rawId != null">AND raw_id = #{rawId}</if>
    <if test="capturedAt != null">AND captured_at = #{capturedAt}</if>
  </where></select>
  <insert id="insertDataSnapshot" parameterType="com.ruoyi.srm.domain.DataSnapshot" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_data_snapshot (supplier_id, credit_code, snapshot_type, snapshot_key, snapshot_hash, payload_json, api_ids, raw_id, captured_at, create_time) VALUES (#{supplierId}, #{creditCode}, #{snapshotType}, #{snapshotKey}, #{snapshotHash}, #{payloadJson}, #{apiIds}, #{rawId}, #{capturedAt}, #{createTime})</insert>
  <update id="updateDataSnapshot" parameterType="com.ruoyi.srm.domain.DataSnapshot">UPDATE srm_data_snapshot<set>
    <if test="supplierId != null">supplier_id = #{supplierId},</if>
    <if test="creditCode != null">credit_code = #{creditCode},</if>
    <if test="snapshotType != null">snapshot_type = #{snapshotType},</if>
    <if test="snapshotKey != null">snapshot_key = #{snapshotKey},</if>
    <if test="snapshotHash != null">snapshot_hash = #{snapshotHash},</if>
    <if test="payloadJson != null">payload_json = #{payloadJson},</if>
    <if test="apiIds != null">api_ids = #{apiIds},</if>
    <if test="rawId != null">raw_id = #{rawId},</if>
    <if test="capturedAt != null">captured_at = #{capturedAt},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteDataSnapshotById" parameterType="Long">DELETE FROM srm_data_snapshot WHERE id = #{id}</delete>
  <delete id="deleteDataSnapshotByIds" parameterType="array">DELETE FROM srm_data_snapshot WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
