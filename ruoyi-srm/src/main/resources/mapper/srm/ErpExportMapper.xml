<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.ErpExportMapper">
  <resultMap id="ErpExportResult" type="com.ruoyi.srm.domain.ErpExport">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="exportNo" column="export_no" jdbcType="VARCHAR" />
    <result property="exportMode" column="export_mode" jdbcType="VARCHAR" />
    <result property="targetSystem" column="target_system" jdbcType="VARCHAR" />
    <result property="scopeDesc" column="scope_desc" jdbcType="VARCHAR" />
    <result property="supplierCount" column="supplier_count" jdbcType="INTEGER" />
    <result property="exportStatus" column="export_status" jdbcType="VARCHAR" />
    <result property="filePath" column="file_path" jdbcType="VARCHAR" />
    <result property="errMsg" column="err_msg" jdbcType="VARCHAR" />
    <result property="createBy" column="create_by" jdbcType="VARCHAR" />
    <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
  </resultMap>
  <sql id="selectErpExportVo">SELECT id, export_no, export_mode, target_system, scope_desc, supplier_count, export_status, file_path, err_msg, create_by, create_time FROM srm_erp_export</sql>
  <select id="selectErpExportById" parameterType="Long" resultMap="ErpExportResult"><include refid="selectErpExportVo"/> WHERE id = #{id}</select>
  <select id="selectErpExportList" parameterType="com.ruoyi.srm.domain.ErpExport" resultMap="ErpExportResult"><include refid="selectErpExportVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="exportNo != null and exportNo != ''">AND export_no = #{exportNo}</if>
    <if test="exportMode != null and exportMode != ''">AND export_mode = #{exportMode}</if>
    <if test="targetSystem != null and targetSystem != ''">AND target_system = #{targetSystem}</if>
    <if test="scopeDesc != null and scopeDesc != ''">AND scope_desc = #{scopeDesc}</if>
    <if test="supplierCount != null">AND supplier_count = #{supplierCount}</if>
    <if test="exportStatus != null and exportStatus != ''">AND export_status = #{exportStatus}</if>
    <if test="filePath != null and filePath != ''">AND file_path = #{filePath}</if>
    <if test="errMsg != null and errMsg != ''">AND err_msg = #{errMsg}</if>
  </where></select>
  <insert id="insertErpExport" parameterType="com.ruoyi.srm.domain.ErpExport" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_erp_export (export_no, export_mode, target_system, scope_desc, supplier_count, export_status, file_path, err_msg, create_by, create_time) VALUES (#{exportNo}, #{exportMode}, #{targetSystem}, #{scopeDesc}, #{supplierCount}, #{exportStatus}, #{filePath}, #{errMsg}, #{createBy}, #{createTime})</insert>
  <update id="updateErpExport" parameterType="com.ruoyi.srm.domain.ErpExport">UPDATE srm_erp_export<set>
    <if test="exportNo != null">export_no = #{exportNo},</if>
    <if test="exportMode != null">export_mode = #{exportMode},</if>
    <if test="targetSystem != null">target_system = #{targetSystem},</if>
    <if test="scopeDesc != null">scope_desc = #{scopeDesc},</if>
    <if test="supplierCount != null">supplier_count = #{supplierCount},</if>
    <if test="exportStatus != null">export_status = #{exportStatus},</if>
    <if test="filePath != null">file_path = #{filePath},</if>
    <if test="errMsg != null">err_msg = #{errMsg},</if>
    <if test="createBy != null">create_by = #{createBy},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteErpExportById" parameterType="Long">DELETE FROM srm_erp_export WHERE id = #{id}</delete>
  <delete id="deleteErpExportByIds">DELETE FROM srm_erp_export WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
