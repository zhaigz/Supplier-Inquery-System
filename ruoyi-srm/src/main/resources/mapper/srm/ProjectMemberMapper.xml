<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.ProjectMemberMapper">
  <resultMap id="ProjectMemberResult" type="com.ruoyi.srm.domain.ProjectMember">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="projectId" column="project_id" jdbcType="BIGINT" />
    <result property="supplierId" column="supplier_id" jdbcType="BIGINT" />
    <result property="supplierCode" column="supplier_code" jdbcType="VARCHAR" />
    <result property="supplierName" column="supplier_name" jdbcType="VARCHAR" />
    <result property="monitorFlag" column="monitor_flag" jdbcType="VARCHAR" />
    <result property="joinTime" column="join_time" jdbcType="TIMESTAMP" />
    <result property="createBy" column="create_by" jdbcType="VARCHAR" />
  </resultMap>
  <sql id="selectProjectMemberVo">SELECT id, project_id, supplier_id, supplier_code, supplier_name, monitor_flag, join_time, create_by FROM srm_project_member</sql>
  <select id="selectProjectMemberById" parameterType="Long" resultMap="ProjectMemberResult"><include refid="selectProjectMemberVo"/> WHERE id = #{id}</select>
  <select id="selectProjectMemberList" parameterType="com.ruoyi.srm.domain.ProjectMember" resultMap="ProjectMemberResult"><include refid="selectProjectMemberVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="projectId != null">AND project_id = #{projectId}</if>
    <if test="supplierId != null">AND supplier_id = #{supplierId}</if>
    <if test="supplierCode != null and supplierCode != ''">AND supplier_code = #{supplierCode}</if>
    <if test="supplierName != null and supplierName != ''">AND supplier_name = #{supplierName}</if>
    <if test="monitorFlag != null and monitorFlag != ''">AND monitor_flag = #{monitorFlag}</if>
    <if test="joinTime != null">AND join_time = #{joinTime}</if>
  </where></select>
  <insert id="insertProjectMember" parameterType="com.ruoyi.srm.domain.ProjectMember" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_project_member (project_id, supplier_id, supplier_code, supplier_name, monitor_flag, join_time, create_by) VALUES (#{projectId}, #{supplierId}, #{supplierCode}, #{supplierName}, #{monitorFlag}, #{joinTime}, #{createBy})</insert>
  <update id="updateProjectMember" parameterType="com.ruoyi.srm.domain.ProjectMember">UPDATE srm_project_member<set>
    <if test="projectId != null">project_id = #{projectId},</if>
    <if test="supplierId != null">supplier_id = #{supplierId},</if>
    <if test="supplierCode != null">supplier_code = #{supplierCode},</if>
    <if test="supplierName != null">supplier_name = #{supplierName},</if>
    <if test="monitorFlag != null">monitor_flag = #{monitorFlag},</if>
    <if test="joinTime != null">join_time = #{joinTime},</if>
    <if test="createBy != null">create_by = #{createBy},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteProjectMemberById" parameterType="Long">DELETE FROM srm_project_member WHERE id = #{id}</delete>
  <delete id="deleteProjectMemberByIds">DELETE FROM srm_project_member WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
