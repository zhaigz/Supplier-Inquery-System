    <result property="taskId" column="task_id" jdbcType="BIGINT" />
    <result property="nodeKey" column="node_key" jdbcType="VARCHAR" />
    <result property="nodeType" column="node_type" jdbcType="VARCHAR" />
    <result property="nodeName" column="node_name" jdbcType="VARCHAR" />
    <result property="creditCode" column="credit_code" jdbcType="VARCHAR" />
    <result property="regStatus" column="reg_status" jdbcType="VARCHAR" />
