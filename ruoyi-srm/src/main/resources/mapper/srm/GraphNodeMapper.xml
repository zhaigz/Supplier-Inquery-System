  </resultMap>
  <sql id="selectGraphNodeVo">SELECT id, task_id, node_key, node_type, node_name, credit_code, reg_status, level_no, parent_node_key, can_extend, red_flag, is_monitor, supplier_id, group_key, attrs_json, ext_json, source_api_id, raw_id, create_time FROM srm_graph_node</sql>
  <select id="selectGraphNodeById" parameterType="Long" resultMap="GraphNodeResult"><include refid="selectGraphNodeVo"/> WHERE id = #{id}</select>
  <select id="selectGraphNodeList" parameterType="com.ruoyi.srm.domain.GraphNode" resultMap="GraphNodeResult"><include refid="selectGraphNodeVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="taskId != null">AND task_id = #{taskId}</if>
    <if test="nodeKey != null and nodeKey != ''">AND node_key = #{nodeKey}</if>
    <if test="nodeType != null and nodeType != ''">AND node_type = #{nodeType}</if>
    <if test="nodeName != null and nodeName != ''">AND node_name = #{nodeName}</if>
    <if test="creditCode != null and creditCode != ''">AND credit_code = #{creditCode}</if>
    <if test="regStatus != null and regStatus != ''">AND reg_status = #{regStatus}</if>
    <if test="levelNo != null">AND level_no = #{levelNo}</if>
    <if test="parentNodeKey != null and parentNodeKey != ''">AND parent_node_key = #{parentNodeKey}</if>
    <if test="canExtend != null and canExtend != ''">AND can_extend = #{canExtend}</if>
    <if test="redFlag != null and redFlag != ''">AND red_flag = #{redFlag}</if>
    <if test="isMonitor != null and isMonitor != ''">AND is_monitor = #{isMonitor}</if>
    <if test="supplierId != null">AND supplier_id = #{supplierId}</if>
    <if test="groupKey != null and groupKey != ''">AND group_key = #{groupKey}</if>
    <if test="attrsJson != null and attrsJson != ''">AND attrs_json = #{attrsJson}</if>
    <if test="extJson != null and extJson != ''">AND ext_json = #{extJson}</if>
    <if test="sourceApiId != null">AND source_api_id = #{sourceApiId}</if>
    <if test="rawId != null">AND raw_id = #{rawId}</if>
  </where></select>
  <insert id="insertGraphNode" parameterType="com.ruoyi.srm.domain.GraphNode" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_graph_node (task_id, node_key, node_type, node_name, credit_code, reg_status, level_no, parent_node_key, can_extend, red_flag, is_monitor, supplier_id, group_key, attrs_json, ext_json, source_api_id, raw_id, create_time) VALUES (#{taskId}, #{nodeKey}, #{nodeType}, #{nodeName}, #{creditCode}, #{regStatus}, #{levelNo}, #{parentNodeKey}, #{canExtend}, #{redFlag}, #{isMonitor}, #{supplierId}, #{groupKey}, #{attrsJson}, #{extJson}, #{sourceApiId}, #{rawId}, #{createTime})</insert>
  <update id="updateGraphNode" parameterType="com.ruoyi.srm.domain.GraphNode">UPDATE srm_graph_node<set>
    <if test="taskId != null">task_id = #{taskId},</if>
    <if test="nodeKey != null">node_key = #{nodeKey},</if>
    <if test="nodeType != null">node_type = #{nodeType},</if>
