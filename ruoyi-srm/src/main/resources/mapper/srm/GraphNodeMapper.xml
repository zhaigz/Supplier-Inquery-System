    <if test="isMonitor != null">is_monitor = #{isMonitor},</if>
    <if test="supplierId != null">supplier_id = #{supplierId},</if>
    <if test="groupKey != null">group_key = #{groupKey},</if>
    <if test="attrsJson != null">attrs_json = #{attrsJson},</if>
    <if test="extJson != null">ext_json = #{extJson},</if>
    <if test="sourceApiId != null">source_api_id = #{sourceApiId},</if>
    <if test="rawId != null">raw_id = #{rawId},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteGraphNodeById" parameterType="Long">DELETE FROM srm_graph_node WHERE id = #{id}</delete>
  <delete id="deleteGraphNodeByIds">DELETE FROM srm_graph_node WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
