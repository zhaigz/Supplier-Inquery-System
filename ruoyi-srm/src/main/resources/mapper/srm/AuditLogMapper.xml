  <insert id="insertAuditLog" parameterType="com.ruoyi.srm.domain.AuditLog" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_audit_log (audit_time, module_name, action_name, object_name, detail, scope_type, operator_id, operator_name, dept_name, source_ip, terminal_id, trace_id, create_time) VALUES (#{auditTime}, #{moduleName}, #{actionName}, #{objectName}, #{detail}, #{scopeType}, #{operatorId}, #{operatorName}, #{deptName}, #{sourceIp}, #{terminalId}, #{traceId}, #{createTime})</insert>
  <update id="updateAuditLog" parameterType="com.ruoyi.srm.domain.AuditLog">UPDATE srm_audit_log<set>
