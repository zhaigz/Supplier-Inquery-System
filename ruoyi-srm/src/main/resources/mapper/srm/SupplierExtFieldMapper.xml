  </set> WHERE id = #{id}</update>
  <delete id="deleteSupplierExtFieldById" parameterType="Long">DELETE FROM srm_supplier_ext_field WHERE id = #{id}</delete>
  <delete id="deleteSupplierExtFieldByIds">DELETE FROM srm_supplier_ext_field WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
