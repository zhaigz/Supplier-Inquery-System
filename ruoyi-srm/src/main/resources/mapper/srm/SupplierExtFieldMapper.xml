  <resultMap id="SupplierExtFieldResult" type="com.ruoyi.srm.domain.SupplierExtField">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="supplierId" column="supplier_id" jdbcType="BIGINT" />
    <result property="fieldCode" column="field_code" jdbcType="VARCHAR" />
    <result property="fieldValue" column="field_value" jdbcType="VARCHAR" />
