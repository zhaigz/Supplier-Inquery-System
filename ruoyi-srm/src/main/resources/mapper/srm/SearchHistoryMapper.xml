<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.SearchHistoryMapper">
  <resultMap id="SearchHistoryResult" type="com.ruoyi.srm.domain.SearchHistory">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="userId" column="user_id" jdbcType="BIGINT" />
    <result property="subjectType" column="subject_type" jdbcType="VARCHAR" />
    <result property="subjectKey" column="subject_key" jdbcType="VARCHAR" />
    <result property="supplierId" column="supplier_id" jdbcType="BIGINT" />
    <result property="matchMode" column="match_mode" jdbcType="VARCHAR" />
    <result property="searchedAt" column="searched_at" jdbcType="TIMESTAMP" />
  </resultMap>
  <sql id="selectSearchHistoryVo">SELECT id, user_id, subject_type, subject_key, supplier_id, match_mode, searched_at FROM srm_search_history</sql>
  <select id="selectSearchHistoryById" parameterType="Long" resultMap="SearchHistoryResult"><include refid="selectSearchHistoryVo"/> WHERE id = #{id}</select>
  <select id="selectSearchHistoryList" parameterType="com.ruoyi.srm.domain.SearchHistory" resultMap="SearchHistoryResult"><include refid="selectSearchHistoryVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="userId != null">AND user_id = #{userId}</if>
    <if test="subjectType != null and subjectType != ''">AND subject_type = #{subjectType}</if>
    <if test="subjectKey != null and subjectKey != ''">AND subject_key = #{subjectKey}</if>
    <if test="supplierId != null">AND supplier_id = #{supplierId}</if>
    <if test="matchMode != null and matchMode != ''">AND match_mode = #{matchMode}</if>
    <if test="searchedAt != null">AND searched_at = #{searchedAt}</if>
  </where></select>
  <insert id="insertSearchHistory" parameterType="com.ruoyi.srm.domain.SearchHistory" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_search_history (user_id, subject_type, subject_key, supplier_id, match_mode, searched_at) VALUES (#{userId}, #{subjectType}, #{subjectKey}, #{supplierId}, #{matchMode}, #{searchedAt})</insert>
  <update id="updateSearchHistory" parameterType="com.ruoyi.srm.domain.SearchHistory">UPDATE srm_search_history<set>
    <if test="userId != null">user_id = #{userId},</if>
    <if test="subjectType != null">subject_type = #{subjectType},</if>
    <if test="subjectKey != null">subject_key = #{subjectKey},</if>
    <if test="supplierId != null">supplier_id = #{supplierId},</if>
    <if test="matchMode != null">match_mode = #{matchMode},</if>
    <if test="searchedAt != null">searched_at = #{searchedAt},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteSearchHistoryById" parameterType="Long">DELETE FROM srm_search_history WHERE id = #{id}</delete>
  <delete id="deleteSearchHistoryByIds" parameterType="array">DELETE FROM srm_search_history WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
