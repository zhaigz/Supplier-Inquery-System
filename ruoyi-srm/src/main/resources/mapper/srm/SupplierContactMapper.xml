  <insert id="insertSupplierContact" parameterType="com.ruoyi.srm.domain.SupplierContact" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_supplier_contact (supplier_id, contact_type, contact_value, raw_value, phone_source, phone_label, is_primary, source_api_id, raw_id, fetched_at, create_time) VALUES (#{supplierId}, #{contactType}, #{contactValue}, #{rawValue}, #{phoneSource}, #{phoneLabel}, #{isPrimary}, #{sourceApiId}, #{rawId}, #{fetchedAt}, #{createTime})</insert>
  <update id="updateSupplierContact" parameterType="com.ruoyi.srm.domain.SupplierContact">UPDATE srm_supplier_contact<set>
