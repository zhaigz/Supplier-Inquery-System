<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.MonitorPolicyMapper">
  <resultMap id="MonitorPolicyResult" type="com.ruoyi.srm.domain.MonitorPolicy">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="policyCode" column="policy_code" jdbcType="VARCHAR" />
    <result property="policyName" column="policy_name" jdbcType="VARCHAR" />
    <result property="supportApi" column="support_api" jdbcType="VARCHAR" />
    <result property="frequency" column="frequency" jdbcType="VARCHAR" />
    <result property="cronExpr" column="cron_expr" jdbcType="VARCHAR" />
    <result property="enabled" column="enabled" jdbcType="VARCHAR" />
    <result property="scanScope" column="scan_scope" jdbcType="VARCHAR" />
    <result property="createBy" column="create_by" jdbcType="VARCHAR" />
    <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
    <result property="updateBy" column="update_by" jdbcType="VARCHAR" />
    <result property="updateTime" column="update_time" jdbcType="TIMESTAMP" />
    <result property="remark" column="remark" jdbcType="VARCHAR" />
  </resultMap>
  <sql id="selectMonitorPolicyVo">SELECT id, policy_code, policy_name, support_api, frequency, cron_expr, enabled, scan_scope, create_by, create_time, update_by, update_time, remark FROM srm_monitor_policy</sql>
  <select id="selectMonitorPolicyById" parameterType="Long" resultMap="MonitorPolicyResult"><include refid="selectMonitorPolicyVo"/> WHERE id = #{id}</select>
  <select id="selectMonitorPolicyList" parameterType="com.ruoyi.srm.domain.MonitorPolicy" resultMap="MonitorPolicyResult"><include refid="selectMonitorPolicyVo"/><where>
    <if test="id != null">AND id = #{id}</if>
    <if test="policyCode != null and policyCode != ''">AND policy_code = #{policyCode}</if>
    <if test="policyName != null and policyName != ''">AND policy_name = #{policyName}</if>
    <if test="supportApi != null and supportApi != ''">AND support_api = #{supportApi}</if>
    <if test="frequency != null and frequency != ''">AND frequency = #{frequency}</if>
    <if test="cronExpr != null and cronExpr != ''">AND cron_expr = #{cronExpr}</if>
    <if test="enabled != null and enabled != ''">AND enabled = #{enabled}</if>
    <if test="scanScope != null and scanScope != ''">AND scan_scope = #{scanScope}</if>
  </where></select>
  <insert id="insertMonitorPolicy" parameterType="com.ruoyi.srm.domain.MonitorPolicy" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_monitor_policy (policy_code, policy_name, support_api, frequency, cron_expr, enabled, scan_scope, create_by, create_time, update_by, update_time, remark) VALUES (#{policyCode}, #{policyName}, #{supportApi}, #{frequency}, #{cronExpr}, #{enabled}, #{scanScope}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{remark})</insert>
  <update id="updateMonitorPolicy" parameterType="com.ruoyi.srm.domain.MonitorPolicy">UPDATE srm_monitor_policy<set>
    <if test="policyCode != null">policy_code = #{policyCode},</if>
    <if test="policyName != null">policy_name = #{policyName},</if>
    <if test="supportApi != null">support_api = #{supportApi},</if>
    <if test="frequency != null">frequency = #{frequency},</if>
    <if test="cronExpr != null">cron_expr = #{cronExpr},</if>
    <if test="enabled != null">enabled = #{enabled},</if>
    <if test="scanScope != null">scan_scope = #{scanScope},</if>
    <if test="createBy != null">create_by = #{createBy},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
    <if test="updateBy != null">update_by = #{updateBy},</if>
    <if test="updateTime != null">update_time = #{updateTime},</if>
    <if test="remark != null">remark = #{remark},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteMonitorPolicyById" parameterType="Long">DELETE FROM srm_monitor_policy WHERE id = #{id}</delete>
  <delete id="deleteMonitorPolicyByIds">DELETE FROM srm_monitor_policy WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
