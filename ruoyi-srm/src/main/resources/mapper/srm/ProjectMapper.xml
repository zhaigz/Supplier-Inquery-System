  </set> WHERE id = #{id}</update>
  <delete id="deleteProjectById" parameterType="Long">DELETE FROM srm_project WHERE id = #{id}</delete>
  <delete id="deleteProjectByIds" parameterType="array">DELETE FROM srm_project WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
