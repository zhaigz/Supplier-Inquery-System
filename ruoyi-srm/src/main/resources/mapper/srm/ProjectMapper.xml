  <insert id="insertProject" parameterType="com.ruoyi.srm.domain.Project" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_project (project_no, project_name, project_date, dept_id, dept_name, project_desc, analysis_param_json, supplier_count, analysis_status, last_task_id, last_report_version_id, status, del_flag, create_by, create_time, update_by, update_time, remark) VALUES (#{projectNo}, #{projectName}, #{projectDate}, #{deptId}, #{deptName}, #{projectDesc}, #{analysisParamJson}, #{supplierCount}, #{analysisStatus}, #{lastTaskId}, #{lastReportVersionId}, #{status}, #{delFlag}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{remark})</insert>
  <update id="updateProject" parameterType="com.ruoyi.srm.domain.Project">UPDATE srm_project<set>
