  <sql id="selectProjectVo">SELECT id, project_no, project_name, project_date, dept_id, dept_name, project_desc, analysis_param_json, supplier_count, analysis_status, last_task_id, last_report_version_id, status, del_flag, create_by, create_time, update_by, update_time, remark FROM srm_project</sql>
  <select id="selectProjectById" parameterType="Long" resultMap="ProjectResult"><include refid="selectProjectVo"/> WHERE id = #{id}</select>
  <select id="selectProjectList" parameterType="com.ruoyi.srm.domain.Project" resultMap="ProjectResult"><include refid="selectProjectVo"/><where>
