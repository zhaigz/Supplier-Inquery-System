  </set> WHERE id = #{id}</update>
  <delete id="deleteClueReviewById" parameterType="Long">DELETE FROM srm_clue_review WHERE id = #{id}</delete>
  <delete id="deleteClueReviewByIds" parameterType="array">DELETE FROM srm_clue_review WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
