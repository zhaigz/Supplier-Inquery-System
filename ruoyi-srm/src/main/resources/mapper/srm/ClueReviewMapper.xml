  <insert id="insertClueReview" parameterType="com.ruoyi.srm.domain.ClueReview" useGeneratedKeys="true" keyProperty="id">INSERT INTO srm_clue_review (clue_id, project_id, report_version_id, review_status, conclusion, review_note, evidence_ref, reviewer_id, reviewer_name, reviewed_at, create_time) VALUES (#{clueId}, #{projectId}, #{reportVersionId}, #{reviewStatus}, #{conclusion}, #{reviewNote}, #{evidenceRef}, #{reviewerId}, #{reviewerName}, #{reviewedAt}, #{createTime})</insert>
  <update id="updateClueReview" parameterType="com.ruoyi.srm.domain.ClueReview">UPDATE srm_clue_review<set>
    <if test="clueId != null">clue_id = #{clueId},</if>
    <if test="projectId != null">project_id = #{projectId},</if>
    <if test="reportVersionId != null">report_version_id = #{reportVersionId},</if>
    <if test="reviewStatus != null">review_status = #{reviewStatus},</if>
    <if test="conclusion != null">conclusion = #{conclusion},</if>
    <if test="reviewNote != null">review_note = #{reviewNote},</if>
