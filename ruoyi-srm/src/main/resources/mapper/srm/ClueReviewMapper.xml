  <sql id="selectClueReviewVo">SELECT id, clue_id, project_id, report_version_id, review_status, conclusion, review_note, evidence_ref, reviewer_id, reviewer_name, reviewed_at, create_time FROM srm_clue_review</sql>
  <select id="selectClueReviewById" parameterType="Long" resultMap="ClueReviewResult"><include refid="selectClueReviewVo"/> WHERE id = #{id}</select>
  <select id="selectClueReviewList" parameterType="com.ruoyi.srm.domain.ClueReview" resultMap="ClueReviewResult"><include refid="selectClueReviewVo"/><where>
