<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.srm.mapper.GraphEdgeMapper">
  <resultMap id="GraphEdgeResult" type="com.ruoyi.srm.domain.GraphEdge">
    <id property="id" column="id" jdbcType="BIGINT" />
    <result property="taskId" column="task_id" jdbcType="BIGINT" />
    <result property="edgeKey" column="edge_key" jdbcType="VARCHAR" />
    <result property="fromNodeKey" column="from_node_key" jdbcType="VARCHAR" />
    <result property="toNodeKey" column="to_node_key" jdbcType="VARCHAR" />
    <result property="fromIdNew" column="from_id_new" jdbcType="VARCHAR" />
    <result property="toIdNew" column="to_id_new" jdbcType="VARCHAR" />
    <result property="relType" column="rel_type" jdbcType="VARCHAR" />
    <result property="ratio" column="ratio" jdbcType="DECIMAL" />
    <result property="ratioLabel" column="ratio_label" jdbcType="VARCHAR" />
    <result property="foundFlag" column="found_flag" jdbcType="VARCHAR" />
    <result property="weight" column="weight" jdbcType="TINYINT" />
    <result property="ruleId" column="rule_id" jdbcType="BIGINT" />
