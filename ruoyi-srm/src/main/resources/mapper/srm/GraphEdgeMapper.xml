    <if test="weight != null">weight = #{weight},</if>
    <if test="ruleId != null">rule_id = #{ruleId},</if>
    <if test="clueId != null">clue_id = #{clueId},</if>
    <if test="sourceApiId != null">source_api_id = #{sourceApiId},</if>
    <if test="rawId != null">raw_id = #{rawId},</if>
    <if test="createTime != null">create_time = #{createTime},</if>
  </set> WHERE id = #{id}</update>
  <delete id="deleteGraphEdgeById" parameterType="Long">DELETE FROM srm_graph_edge WHERE id = #{id}</delete>
  <delete id="deleteGraphEdgeByIds">DELETE FROM srm_graph_edge WHERE id IN <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
